{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "client"
      ],
      "port": 5173
    },
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "server"
      ],
      "port": 3001
    },
    {
      "name": "api-sin-supabase",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "SUPABASE_URL=http://127.0.0.1:9",
        "SUPABASE_ANON_KEY=sb_publishable_falsa",
        "SUPABASE_SERVICE_ROLE_KEY=sb_secret_falsa",
        "OPENROUTER_API_KEY=falsa",
        "NODE_ENV=test",
        "PORT=3011",
        "node",
        "server/src/server.js"
      ],
      "port": 3011
    }
  ]
}
