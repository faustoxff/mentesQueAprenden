{
  "name": "clinica-server",
  "version": "1.0.0",
  "description": "Backend - Sistema de Gestión Clínica Interdisciplinaria",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/utils/runMigrations.js",
    "test": "cross-env NODE_ENV=test TZ=America/Argentina/Buenos_Aires jest --runInBand --selectProjects unit",
    "test:integration": "cross-env NODE_ENV=test TZ=America/Argentina/Buenos_Aires jest --runInBand --selectProjects integration",
    "test:all": "cross-env NODE_ENV=test TZ=America/Argentina/Buenos_Aires jest --runInBand",
    "test:coverage": "cross-env NODE_ENV=test TZ=America/Argentina/Buenos_Aires jest --runInBand --selectProjects unit --coverage",
    "lint": "eslint src __tests__"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "openai": "^4.67.0",
    "pdf-parse": "^2.4.5",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "jest": "^30.5.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
